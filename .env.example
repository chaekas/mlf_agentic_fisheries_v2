# MLF Fisheries Agentic AI - local development
# Docker PostgreSQL is exposed on Windows port 5433.

DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5433/mlf_fisheries
CHECKPOINT_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/mlf_fisheries

# Groq
GROQ_API_KEY=YOUR_GROQ_API_KEY
GROQ_MODEL=llama-3.3-70b-versatile

# Vector store
PGVECTOR_COLLECTION=mlf_fisheries_regulations
EMBEDDING_MODEL=BAAI/bge-m3

# Retrieval
TOP_K=6
MIN_RELEVANCE=0.48

# Uploads
UPLOAD_DIR=data/uploads
